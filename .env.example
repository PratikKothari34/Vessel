# ── Vessel backend configuration ──────────────────────────────────────────
# Copy to ".env" and fill in. The app runs LOCAL-ONLY if the TURSO_* vars are
# left blank — cloud sync is opt-in.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# CORS allow-list. Vite dev server origin; packaged Electron sends no Origin.
ALLOWED_ORIGINS=http://localhost:5173

# ── Inference backend ─────────────────────────────────────────────────────
# Which engine generates tokens: "ollama" (default), "llama-server", or
# "llama-local".
#
# llama-server holds one model for the life of the process: nothing can evict
# it, the summarizer shares the same resident weights, and it reports how many
# prompt tokens it actually reused (timings.cache_n) instead of making us
# estimate. Measured on an RTX 4060 8GB at the same window as Ollama:
#   decode 46.5 vs 39.4 tok/s | prefill ~2,200 vs ~1,600 tok/s
#   6.03 GB vs 6.4 GB resident | summary costs 0 ms of reload, not 19,365 ms
INFERENCE_BACKEND=ollama
# Embeddings are switchable on their own, because one llama-server serves one
# model and the embedder runs on CPU anyway. Leave on ollama unless you have a
# second llama-server up with --embedding --pooling mean.
EMBED_BACKEND=ollama
# Where llama-server is listening. Launch it with the context window baked in --
# it is a launch flag there, not a request field:
#   llama-server -m <model.gguf> -c 12288 -ngl 99 --parallel 1 #                --host 127.0.0.1 --port 8080
# --parallel 1 is REQUIRED, not a preference: --parallel DIVIDES -c. The default
# of 4 turns -c 12288 into n_ctx_slot 3072 and silently truncates every long
# conversation to a quarter of its configured window, at identical VRAM and
# decode. Vessel is single-user and serialises the summariser, so the other
# three slots are never used. See docs/MASTER.md, "Launch it with --parallel 1".
# Using the copy Ollama ships (Windows) needs its CUDA backend pointed at
# explicitly, or it silently falls back to CPU:
#   set GGML_BACKEND_PATH=%LOCALAPPDATA%\Programs\Ollama\lib\ollama\cuda_v13\ggml-cuda.dll
LLAMA_CHAT_URL=http://127.0.0.1:8080
LLAMA_EMBED_URL=http://127.0.0.1:8081
# Name reported back in the stream. Cosmetic: one server serves one model.
LLAMA_CHAT_MODEL=vessel
# KV prefix reuse across turns. 1 = on (the point of the backend); 0 to measure
# the cost of a cold prefill.
LLAMA_CACHE_PROMPT=1
# Attach per-token timings, the only way to read cache_n on /v1/chat/completions.
LLAMA_TIMINGS=1

# -- llama-local (INFERENCE_BACKEND=llama-local) ---------------------------
# llama.cpp inside the app: no server to start, no loopback hop. Only present
# in a build compiled with the feature:
#   cargo build --features local-llama-cuda   (or local-llama for CPU)
# Selecting it in a build without the feature is a startup error that says so.
#
# It serves ONE model, so it chats and summarises off the same resident weights
# (no second model, no reload) and ignores SUMMARIZER_MODEL. It does not embed:
# leave EMBED_BACKEND on ollama or llama-server.
#
# Which weights. Unset, they are looked up in the Ollama store by
# LLAMA_CHAT_MODEL / OLLAMA_MODEL -- the same name the other two backends use,
# and the same file, so a switch changes the plumbing and not the model. Set it
# to point somewhere else; the path wins outright.
#LLAMA_GGUF=C:/models/vessel-q4_k_m.gguf
# Context window, fixed when the model loads (a per-request num_ctx is ignored
# and warned about). Falls back to OLLAMA_NUM_CTX so there is one number to
# change, not two.
#LLAMA_NUM_CTX=12288
# Layers on the GPU. 99 means all of them, which is what the 4060 measurement
# assumes; lower it only on a smaller card.
#LLAMA_NGL=99
# KV cache element type: f16 (default), f32, q8_0, q5_1, q5_0, q4_1, q4_0.
# f16 because q8_0 was measured and rejected -- it bought VRAM that the 12288
# window did not need and cost quality. An unknown value is a startup error,
# not a silent fallback.
#LLAMA_KV_TYPE=f16
# Prefill batch size, and the decode thread count (default: every core).
#LLAMA_N_BATCH=2048
#LLAMA_THREADS=8

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Chat model built from the Modelfile (ollama create vessel -f Modelfile)
OLLAMA_MODEL=vessel
# Context window sent with every chat request. Overrides the Modelfile, so
# changing it never requires rebuilding the Ollama model. 12288 is measured:
# at the Modelfile default of 32768 the model needs 9.52 GB and spills 3.27 GB
# to CPU on an 8 GB card (13.7 tok/s); at 12288 it is fully GPU-resident
# (39.4 tok/s). Raise only if prompt_eval_count at /metrics approaches it.
OLLAMA_NUM_CTX=12288
# On INFERENCE_BACKEND=llama-server this value is NOT sent (the window is fixed
# by -c at launch); it is only compared against the running server's /props and
# warned about on startup if they disagree.
# Which engine writes the rolling summary. Separate from INFERENCE_BACKEND for
# two reasons: the summariser must not share the chat model's GPU (below), and
# llama-server ACCEPTS a model argument then ignores it -- one server, one model
# -- so routing the summariser there silently replaces SUMMARIZER_MODEL with the
# chat model. /health reports summarize.honoursModel so that cannot go quiet.
SUMMARIZER_BACKEND=ollama
# Librarian model that condenses old turns into the rolling summary.
# Do NOT set this to the chat model to "save" VRAM: scored on 13 facts, gemma3:4b
# keeps 12-13 and invents nothing, while vessel keeps 8 and invents named
# characters. A summary is read back as canon every turn, so a confabulation
# becomes permanent story fact. See docs/MASTER.md, "SUMMARIZER_MODEL was
# silently ignored".
SUMMARIZER_MODEL=gemma3:4b
# Small context for the summarizer so reasoning models don't allocate a huge KV cache.
# Leave unset when SUMMARIZER_MODEL is the chat model: it then defaults to
# OLLAMA_NUM_CTX so both share one resident slot. Ollama keys a loaded model
# on (model, num_ctx), so a mismatch here evicts the chat model on every
# summary and costs a ~19 s reload before the next reply.
SUMMARIZER_NUM_CTX=8192
# Summariser GPU layers: 0 = CPU, -1 = let Ollama decide. Keep this at 0.
# The 8 GB card holds 6.16 GB of chat model; loading a 3 GB summariser beside it
# puts the card at 96% and the Windows driver pages 2.3 GB of the chat model out
# to system RAM -- decode collapses from 47.0 to 20.8 tok/s. On CPU the
# summariser costs 0 MiB of VRAM and 95-239 s of wall clock that nobody waits
# on, because folding runs as background maintenance off the turn lock.
SUMMARIZER_NUM_GPU=0
# Length steer for the summary, in characters. The summariser is not told about
# MAX_SUMMARY_CHARS otherwise, and gemma answers with 5,800-12,400 chars against
# a 6,000 cap -- the overflow is then cut off the FRONT, amputating the oldest
# and least recoverable material. Defaults to MAX_SUMMARY_CHARS * 0.4. Steering
# lower than ~1,800 makes the model drop facts instead of compressing them.
# SUMMARY_TARGET_CHARS=2400
# Embedding model for retrieval (produces 768-dim vectors).
EMBED_MODEL=nomic-embed-text
# Embedder GPU layers: 0 = CPU (faster load, frees VRAM), -1 = let Ollama decide.
EMBED_NUM_GPU=0
# Store embeddings as int8 + a per-vector scale instead of raw float32: 3072 ->
# 774 bytes per archived turn (3.97x), with a max cosine error of 1.2e-3 and no
# change in ranking. Set to 0 to write float32; both formats stay readable, so
# flipping this never invalidates existing rows.
EMBED_QUANTIZE=1

# ── Turso sync ────────────────────────────────────────────────────────────
# Local-first DB file (source of truth, always used). Cloud sync via the
# @tursodatabase/sync push/pull protocol.
LOCAL_DB_PATH=./data/scenario.db
# NOTE: sync credentials are normally set IN THE APP (Settings → Cloud sync):
# URL → data/settings.json, token → OS keychain. Values saved there OVERRIDE
# these env vars. The vars below are dev-only fallbacks.
# Leave BOTH blank for local-only mode. Fill in to enable cloud backup/sync.
TURSO_DATABASE_URL=
# Optional: the auth token is normally stored in the OS keychain. If set here on
# first run it's migrated into the keychain automatically; afterwards .env isn't
# needed for it. Leave blank to use the keychain only.
TURSO_AUTH_TOKEN=
# Background push+pull cadence (seconds). 0 = sync only on startup/shutdown.
TURSO_SYNC_INTERVAL=60
# Kill switch for cloud sync, for test harnesses. Presence-only: setting it to
# ANY value -- including 0 or empty -- forces local-only for that process, and
# the startup banner prints "sync: local-only". Deliberately not a boolean,
# because a harness that mentions this variable at all means it, and the cost of
# guessing wrong is writing test data into a real database.
# VESSEL_NO_SYNC=1

# ── Encryption at rest ──────────────────────────────────────────────────────
# The local DB is encrypted with aes256gcm using a 256-bit key kept in the OS
# keychain (Windows Credential Manager), generated automatically on first run.
# You normally leave this BLANK. Set it only to bring your own key (e.g. to move
# an encrypted DB between machines). WARNING: changing/removing the key for an
# existing encrypted DB makes it unreadable.
#
# CAVEAT: encryption applies in LOCAL-ONLY mode. The Turso sync engine has no
# local-file encryption, so enabling cloud sync (above) means the local file is
# plaintext — the backend warns at startup and reports the live state as
# "encryptedAtRest" in GET /health. An existing plaintext DB is migrated to
# encrypted automatically, keeping a *.plaintext-backup you should delete.
DB_ENCRYPTION_KEY=

# ── Memory tuning ─────────────────────────────────────────────────────────
# Recent turns always kept verbatim in the live window.
VERBATIM_TURNS=8
# When verbatim exceeds this, fold the oldest into the summary + archive.
SUMMARIZE_THRESHOLD=12
# Ceiling on verbatim rows the PROMPT may include. Folding runs in the
# background, so between crossing the threshold and the fold landing there are
# legitimately more rows than VERBATIM_TURNS; this stops a slow fold from
# growing the prompt without bound. Defaults to SUMMARIZE_THRESHOLD + 2, which
# is what the old synchronous design already peaked at. The UI still shows every
# turn -- this bounds what is sent to the model, not what is stored.
# VERBATIM_CEILING=14
# Max archived turns retrieval may inject per request.
RETRIEVE_K=4
# Min cosine similarity (0-1) for a retrieved turn to count as relevant.
RETRIEVE_MIN_SCORE=0.45
# Conversations that keep their archive vectors resident for retrieval. ~3 KB per
# archived turn, so 8 stories of 1,000 turns is ~24 MB.
ARCHIVE_CACHE_CONVS=8
# Parallel embed calls when folding turns into the archive. This whole phase runs
# underneath the summarizer call, so it is off the user's critical path either way.
EMBED_CONCURRENCY=4
# Hard cap on rolling-summary length (chars).
MAX_SUMMARY_CHARS=6000
# Per-conversation lock timeout (ms) so a wedged turn can't block future turns.
LOCK_WAIT_MS=120000
